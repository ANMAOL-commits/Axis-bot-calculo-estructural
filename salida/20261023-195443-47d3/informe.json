  "titulo": "Memoria de cálculo estructural – Vivienda unifamiliar – EJEMPLO (reemplazar)",
  "secciones": [
    {
      "titulo": "Objeto",
      "bloques": [
        {
          "type": "p",
          "text": "El presente informe presenta la memoria de cálculo estructural de **Vivienda unifamiliar – EJEMPLO (reemplazar)** (Mendoza – Capital), elaborada a partir de la Planilla Unificada de Cálculo Estructural. Se verifican losas, vigas, columnas, acción sísmica, muros resistentes y fundaciones conforme a los reglamentos CIRSOC 101, CIRSOC 201 e INPRES-CIRSOC 103."
        }
      ]
    },
    {
      "titulo": "Normativa y criterios de cálculo",
      "bloques": [
        {
          "type": "bullets",
          "items": [
